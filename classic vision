<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classic Vision | Electric PVC Items</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#f59e0b',
                        darkBg: '#0f172a',
                        cardBg: '#1e293b'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-darkBg text-gray-100 font-sans min-h-screen selection:bg-primary selection:text-white">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-40 bg-darkBg/95 backdrop-blur border-b border-gray-800 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-400 flex items-center justify-center shadow-md shadow-amber-500/20">
                    <i class="fa-solid fa-bolt text-darkBg text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black tracking-wider text-white">CLASSIC VISION</h1>
                    <p class="text-xs text-amber-400 font-medium tracking-wide">ELECTRIC PVC ITEMS</p>
                </div>
            </div>

            <!-- Search -->
            <div class="hidden md:flex items-center flex-1 max-w-md mx-8">
                <div class="relative w-full">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-gray-400">
                        <i class="fa-solid fa-search"></i>
                    </span>
                    <input type="text" id="searchInput" oninput="filterProducts()" placeholder="Search PVC pipes, junction boxes..." class="w-full pl-10 pr-4 py-2.5 bg-cardBg border border-gray-700 rounded-xl text-sm focus:outline-none focus:border-primary text-gray-200 placeholder-gray-400 transition">
                </div>
            </div>

            <div class="flex items-center space-x-2 sm:space-x-3">
                <button onclick="installApp()" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 font-semibold px-3 py-2 rounded-xl text-xs sm:text-sm flex items-center space-x-1.5 transition">
                    <i class="fa-solid fa-download"></i>
                    <span class="hidden sm:inline">Follow / Install</span>
                </button>

                <div title="Real Store Views" class="bg-cardBg border border-gray-700 text-gray-300 px-3 py-2 rounded-xl text-xs sm:text-sm flex items-center space-x-1.5">
                    <i class="fa-solid fa-eye text-primary"></i>
                    <span id="visitorCountBadge" class="font-bold text-white">0</span>
                </div>

                <button onclick="openAdminModal()" class="bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-500 hover:to-amber-500 text-white font-bold px-3 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm flex items-center space-x-1.5 shadow-lg transition">
                    <i class="fa-solid fa-lock"></i>
                    <span>Admin</span>
                </button>

                <button onclick="openCart()" class="relative bg-cardBg hover:bg-gray-800 border border-gray-700 text-white px-3 sm:px-4 py-2.5 rounded-xl flex items-center space-x-1.5 transition">
                    <i class="fa-solid fa-cart-shopping text-primary"></i>
                    <span class="text-xs sm:text-sm font-semibold hidden sm:inline">Cart</span>
                    <span id="cartBadge" class="absolute -top-2 -right-2 bg-primary text-darkBg font-black text-xs w-5 h-5 rounded-full flex items-center justify-center shadow">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="bg-gradient-to-r from-cardBg via-slate-800 to-cardBg border border-gray-800 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
            <div class="max-w-2xl relative z-10">
                <span class="inline-block bg-primary/10 text-primary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-4 border border-primary/20">Heavy-Duty Electrical Fittings</span>
                <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
                    Reliable Electric PVC Solutions by <span class="text-primary">Classic Vision</span>
                </h2>
                <p class="text-gray-300 text-base sm:text-lg mb-8 leading-relaxed">
                    High-grade PVC conduit pipes, fire-retardant junction boxes, switch gang boxes, and cable trunking patti at wholesale & retail rates across Pakistan.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="#productsSection" class="bg-primary hover:bg-amber-400 text-darkBg font-bold px-6 py-3.5 rounded-xl shadow-lg transition flex items-center space-x-2">
                        <span>Browse PVC Items</span>
                        <i class="fa-solid fa-arrow-down"></i>
                    </a>
                    <a id="whatsappSupportBtn" href="#" target="_blank" class="bg-cardBg hover:bg-gray-700 border border-gray-700 text-white font-semibold px-6 py-3.5 rounded-xl transition flex items-center space-x-2">
                        <i class="fa-brands fa-whatsapp text-green-400 text-lg"></i>
                        <span>Contact & Support</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Products Section -->
    <main id="productsSection" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4 border-b border-gray-800 pb-6">
            <div>
                <h3 class="text-2xl font-black text-white">Our PVC Products</h3>
                <p id="syncStatus" class="text-xs text-green-400 mt-1"><i class="fa-solid fa-circle text-[8px] mr-1"></i> Real-time Store Synced</p>
            </div>
            <div id="categoryTabs" class="flex flex-wrap gap-2"></div>
        </div>

        <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </main>

    <!-- Cart Modal -->
    <div id="cartModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-cardBg border border-gray-700 w-full max-w-lg rounded-3xl p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between border-b border-gray-700 pb-4 mb-4">
                <h3 class="text-xl font-bold text-white"><i class="fa-solid fa-cart-shopping text-primary mr-2"></i> Your Cart</h3>
                <button onclick="closeCart()" class="text-gray-400 hover:text-white text-xl w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">&times;</button>
            </div>
            
            <div id="cartItemsList" class="flex-1 overflow-y-auto space-y-3 pr-1"></div>
            
            <div class="border-t border-gray-700 pt-4 mt-4">
                <div class="flex justify-between items-center mb-4">
                    <span class="text-gray-400">Total Amount:</span>
                    <span id="cartTotal" class="text-2xl font-black text-primary">Rs. 0</span>
                </div>
                <div class="space-y-3">
                    <input type="text" id="customerName" placeholder="Your Full Name" class="w-full px-4 py-3 bg-darkBg border border-gray-700 rounded-xl text-sm text-white focus:outline-none focus:border-primary">
                    <input type="tel" id="customerPhone" placeholder="Mobile / Phone Number" class="w-full px-4 py-3 bg-darkBg border border-gray-700 rounded-xl text-sm text-white focus:outline-none focus:border-primary">
                    <textarea id="customerAddress" placeholder="Delivery Address / City" rows="2" class="w-full px-4 py-3 bg-darkBg border border-gray-700 rounded-xl text-sm text-white focus:outline-none focus:border-primary resize-none"></textarea>
                    
                    <button onclick="checkoutWhatsApp()" class="w-full bg-green-600 hover:bg-green-500 text-white font-bold py-3.5 rounded-xl shadow-lg transition flex items-center justify-center space-x-2">
                        <i class="fa-brands fa-whatsapp text-xl"></i>
                        <span>Send Order on WhatsApp</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin Login Modal -->
    <div id="adminLoginModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-cardBg border border-gray-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl">
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-red-500/10 border border-red-500/20 rounded-2xl flex items-center justify-center mx-auto mb-3 text-red-500 text-2xl">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h3 class="text-xl font-bold text-white">Admin Panel Login</h3>
                <p class="text-xs text-gray-400 mt-1">Default PIN: 1234</p>
            </div>
            <input type="password" id="adminPinInput" placeholder="Enter PIN" class="w-full px-4 py-3 bg-darkBg border border-gray-700 rounded-xl text-center text-lg tracking-widest text-white focus:outline-none focus:border-primary mb-4">
            <div class="flex space-x-3">
                <button onclick="closeAdminLogin()" class="flex-1 bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-3 rounded-xl transition">Cancel</button>
                <button onclick="verifyAdminPin()" class="flex-1 bg-primary hover:bg-amber-400 text-darkBg font-bold py-3 rounded-xl transition">Unlock</button>
            </div>
        </div>
    </div>

    <!-- Admin Dashboard Modal -->
    <div id="adminDashboardModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-cardBg border border-gray-700 w-full max-w-3xl rounded-3xl p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between border-b border-gray-700 pb-4 mb-4">
                <div>
                    <h3 class="text-lg font-bold text-white">Classic Vision - Live Cloud Admin</h3>
                    <p class="text-xs text-green-400">Manage products instantly!</p>
                </div>
                <button onclick="closeAdminDashboard()" class="text-gray-400 hover:text-white text-xl w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">&times;</button>
            </div>

            <div class="flex-1 overflow-y-auto space-y-6 pr-2">
                <div class="bg-darkBg p-4 rounded-2xl border border-gray-800">
                    <h4 class="text-sm font-bold text-amber-400 mb-3">Store WhatsApp & PIN</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <input type="text" id="adminWhatsappInput" placeholder="WhatsApp (92300...)" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                        <input type="text" id="adminNewPinInput" placeholder="New PIN (Optional)" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                    </div>
                    <button onclick="saveStoreSettings()" class="mt-3 w-full bg-primary hover:bg-amber-400 text-darkBg font-bold py-2.5 rounded-xl text-sm transition">Save Settings</button>
                </div>

                <!-- Add/Edit Product Box -->
                <div class="bg-darkBg p-4 rounded-2xl border border-gray-800">
                    <h4 id="formTitle" class="text-sm font-bold text-amber-400 mb-3">Add New PVC Product</h4>
                    <input type="hidden" id="editProductId" value="">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                        <input type="text" id="newProdName" placeholder="Product Name" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                        <input type="number" id="newProdPrice" placeholder="Price in PKR" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                        <select id="newProdCategory" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white"></select>
                        <input type="text" id="newProdNote" placeholder="Product Note (Optional)" class="px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                        
                        <div class="col-span-full bg-cardBg border border-gray-700 rounded-xl p-2.5 flex flex-col justify-center">
                            <label class="block text-xs text-amber-400 font-semibold mb-1"><i class="fa-solid fa-image mr-1"></i> Select Image from Gallery (Auto-Compressed)</label>
                            <input type="file" id="newProdImageFile" accept="image/*" class="text-xs text-gray-300 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-primary file:text-darkBg hover:file:bg-amber-400 cursor-pointer">
                        </div>
                    </div>
                    <div class="flex space-x-2">
                        <button id="addProdBtn" onclick="saveOrUpdateProduct()" class="flex-1 bg-green-600 hover:bg-green-500 text-white font-bold py-2.5 rounded-xl text-sm transition">Save & Publish Instantly</button>
                        <button id="cancelEditBtn" onclick="resetProductForm()" class="hidden bg-gray-700 hover:bg-gray-600 text-white font-bold px-4 py-2.5 rounded-xl text-sm transition">Cancel</button>
                    </div>
                </div>

                <!-- Manage Categories -->
                <div class="bg-darkBg p-4 rounded-2xl border border-gray-800">
                    <h4 class="text-sm font-bold text-amber-400 mb-3">Manage Categories</h4>
                    <div class="flex space-x-2 mb-3">
                        <input type="text" id="newCategoryName" placeholder="New Category Name" class="flex-1 px-3 py-2 bg-cardBg border border-gray-700 rounded-xl text-sm text-white">
                        <button onclick="addNewCategory()" class="bg-primary hover:bg-amber-400 text-darkBg font-bold px-4 py-2 rounded-xl text-sm transition">+ Add Category</button>
                    </div>
                    <div id="adminCategoryList" class="flex flex-wrap gap-2"></div>
                </div>

                <div class="bg-darkBg p-4 rounded-2xl border border-gray-800">
                    <h4 class="text-sm font-bold text-amber-400 mb-3">Live Products on Store</h4>
                    <div id="adminProductList" class="space-y-2"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const FIREBASE_URL = "https://classic-vision-52e66-default-rtdb.firebaseio.com"; 
        let deferredPrompt;

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
        });

        function installApp() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    deferredPrompt = null;
                });
            } else {
                alert("App is already installed or your browser doesn't support direct home screen installation.");
            }
        }

        // Clean initial state with NO default sample items
        let storeData = {
            whatsapp: "923001234567",
            adminPin: "1234",
            categories: ["PVC Pipes", "Junction Boxes", "Switch Gang Boxes", "Cable Trunking Patti"],
            products: []
        };
        let cart = [];
        let currentFilter = "All";

        function loadLocalFirst() {
            let cached = localStorage.getItem('classicVisionStoreData');
            if (cached) {
                try {
                    let parsed = JSON.parse(cached);
                    if (parsed && parsed.products) {
                        storeData = parsed;
                    }
                } catch(e) {}
            }
            renderApp();
        }

        function getDbEndpoint() {
            let cleanUrl = FIREBASE_URL.replace(/\/$/, "");
            return `${cleanUrl}/storeData.json`;
        }

        function getViewsEndpoint() {
            let cleanUrl = FIREBASE_URL.replace(/\/$/, "");
            return `${cleanUrl}/realViews.json`;
        }

        async function updateRealViews() {
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 3000);
                let res = await fetch(getViewsEndpoint(), { signal: controller.signal });
                clearTimeout(timeoutId);
                let currentViews = await res.json();
                let newCount = (typeof currentViews === 'number' && currentViews >= 0) ? currentViews + 1 : 1;
                
                await fetch(getViewsEndpoint(), {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(newCount)
                });
                
                document.getElementById('visitorCountBadge').innerText = newCount;
            } catch (err) {
                console.error("Views update error:", err);
            }
        }

        async function loadCloudData() {
            loadLocalFirst(); 
            updateRealViews();
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 3000); 
                
                let res = await fetch(getDbEndpoint(), { signal: controller.signal });
                clearTimeout(timeoutId);
                
                let data = await res.json();
                if (data && data.products) {
                    storeData = data;
                    localStorage.setItem('classicVisionStoreData', JSON.stringify(storeData));
                    renderApp();
                }
            } catch (err) {
                console.log("Using local cache instantly.");
            }
        }

        async function saveCloudData() {
            localStorage.setItem('classicVisionStoreData', JSON.stringify(storeData));
            renderApp();
            try {
                await fetch(getDbEndpoint(), {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(storeData)
                });
            } catch (err) {
                console.error("Data save error.");
            }
        }

        function renderApp() {
            if (storeData.whatsapp) {
                let btn = document.getElementById('whatsappSupportBtn');
                if (btn) btn.href = `https://wa.me/${storeData.whatsapp}?text=Hello%20Classic%20Vision,%20I%20want%20to%20inquire%20about%20electric%20PVC%20items.`;
            }
            
            let tabsHtml = `<button onclick="filterCategory('All')" class="px-4 py-2 rounded-xl text-sm font-semibold ${currentFilter === 'All' ? 'bg-primary text-darkBg' : 'bg-cardBg text-gray-300 hover:bg-gray-800'} transition">All Items</button>`;
            (storeData.categories || []).forEach(cat => {
                tabsHtml += `<button onclick="filterCategory('${cat}')" class="px-4 py-2 rounded-xl text-sm font-semibold ${currentFilter === cat ? 'bg-primary text-darkBg' : 'bg-cardBg text-gray-300 hover:bg-gray-800'} transition">${cat}</button>`;
            });
            let catTabs = document.getElementById('categoryTabs');
            if (catTabs) catTabs.innerHTML = tabsHtml;

            let grid = document.getElementById('productGrid');
            let searchInput = document.getElementById('searchInput');
            let query = searchInput ? searchInput.value.toLowerCase() : "";
            
            let productsArr = storeData.products || [];
            let filtered = productsArr.filter(p => {
                let matchesCat = currentFilter === 'All' || p.category === currentFilter;
                let matchesSearch = p.name.toLowerCase().includes(query);
                return matchesCat && matchesSearch;
            });

            if (grid) {
                if (filtered.length === 0) {
                    grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400">No PVC items added yet. Use Admin panel to add products!</div>`;
                } else {
                    let html = "";
                    filtered.forEach(p => {
                        html += `
                            <div class="bg-cardBg border border-gray-800 rounded-2xl overflow-hidden hover:border-primary/50 transition shadow-lg flex flex-col">
                                <div class="h-48 overflow-hidden bg-gray-900 relative">
                                    <img src="${p.image || 'https://images.unsplash.com/photo-1584438784894-089d6a62b8fa?w=500'}" alt="${p.name}" class="w-full h-full object-cover">
                                    <span class="absolute top-3 left-3 bg-darkBg/80 backdrop-blur text-xs font-semibold text-amber-400 px-2.5 py-1 rounded-lg border border-gray-700">${p.category}</span>
                                </div>
                                <div class="p-4 flex-1 flex flex-col justify-between">
                                    <div>
                                        <h4 class="font-bold text-white text-base mb-0.5">${p.name}</h4>
                                        ${p.note ? `<p class="text-xs text-gray-400 mb-2 italic"><i class="fa-solid fa-circle-info mr-1 text-amber-400"></i>${p.note}</p>` : '<div class="mb-2"></div>'}
                                        <p class="text-primary font-black text-lg mb-4">Rs. ${p.price}</p>
                                    </div>
                                    <button onclick="addToCart(${p.id})" class="w-full bg-primary/10 hover:bg-primary text-primary hover:text-darkBg font-bold py-2.5 rounded-xl border border-primary/20 transition flex items-center justify-center space-x-2">
                                        <i class="fa-solid fa-cart-plus"></i>
                                        <span>Add to Cart</span>
                                    </button>
                                </div>
                            </div>
                        `;
                    });
                    grid.innerHTML = html;
                }
            }
            renderAdminLists();
        }

        function filterCategory(cat) { currentFilter = cat; renderApp(); }
        function filterProducts() { renderApp(); }

        function addToCart(id) {
            let prod = storeData.products.find(p => p.id === id);
            let exist = cart.find(item => item.id === id);
            if (exist) exist.qty++;
            else cart.push({...prod, qty: 1});
            updateCartBadge();
        }

        function updateCartBadge() {
            let badge = document.getElementById('cartBadge');
            if (badge) badge.innerText = cart.reduce((sum, item) => sum + item.qty, 0);
        }

        function openCart() {
            let list = document.getElementById('cartItemsList');
            if (cart.length === 0) {
                list.innerHTML = `<p class="text-center text-gray-400 py-8">Your cart is empty.</p>`;
                document.getElementById('cartTotal').innerText = "Rs. 0";
                document.getElementById('cartModal').classList.remove('hidden');
                return;
            }
            let html = "";
            let total = 0;
            cart.forEach((item, index) => {
                total += item.price * item.qty;
                html += `
                    <div class="flex items-center justify-between bg-darkBg p-3 rounded-xl border border-gray-800">
                        <div>
                            <h5 class="font-bold text-sm text-white">${item.name}</h5>
                            ${item.note ? `<p class="text-[10px] text-gray-400 italic">${item.note}</p>` : ''}
                            <p class="text-xs text-primary font-semibold">Rs. ${item.price} x ${item.qty}</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="changeQty(${index}, -1)" class="w-7 h-7 bg-gray-800 rounded-lg text-gray-300 font-bold">-</button>
                            <span class="text-sm font-bold text-white">${item.qty}</span>
                            <button onclick="changeQty(${index}, 1)" class="w-7 h-7 bg-gray-800 rounded-lg text-gray-300 font-bold">+</button>
                        </div>
                    </div>
                `;
            });
            list.innerHTML = html;
            document.getElementById('cartTotal').innerText = `Rs. ${total}`;
            document.getElementById('cartModal').classList.remove('hidden');
        }

        function closeCart() { document.getElementById('cartModal').classList.add('hidden'); }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if (cart[index].qty <= 0) cart.splice(index, 1);
            updateCartBadge();
            openCart();
        }

        function checkoutWhatsApp() {
            let name = document.getElementById('customerName').value.trim();
            let phone = document.getElementById('customerPhone').value.trim();
            let address = document.getElementById('customerAddress').value.trim();

            if (!name || !phone || !address) { alert("Please fill name, phone and address."); return; }
            if (cart.length === 0) { alert("Cart is empty."); return; }

            let text = `*New Order - Classic Vision*%0A%0A*Name:* ${name}%0A*Phone:* ${phone}%0A*Address:* ${address}%0A%0A*Order Items:*%0A`;
            let total = 0;
            cart.forEach(item => {
                text += `- ${item.name} ${item.note ? '('+item.note+')':''} (x${item.qty}) : Rs. ${item.price * item.qty}%0A`;
                total += item.price * item.qty;
            });
            text += `%0A*Total Amount:* Rs. ${total}`;
            window.open(`https://wa.me/${storeData.whatsapp}?text=${text}`, '_blank');
        }

        function openAdminModal() { document.getElementById('adminLoginModal').classList.remove('hidden'); }
        function closeAdminLogin() { document.getElementById('adminLoginModal').classList.add('hidden'); document.getElementById('adminPinInput').value = ""; }
        function verifyAdminPin() {
            let pin = document.getElementById('adminPinInput').value;
            if (pin === storeData.adminPin) {
                closeAdminLogin();
                document.getElementById('adminDashboardModal').classList.remove('hidden');
                document.getElementById('adminWhatsappInput').value = storeData.whatsapp;
                renderAdminLists();
            } else { alert("Incorrect PIN!"); }
        }
        function closeAdminDashboard() { document.getElementById('adminDashboardModal').classList.add('hidden'); }

        async function saveStoreSettings() {
            storeData.whatsapp = document.getElementById('adminWhatsappInput').value.trim();
            let newPin = document.getElementById('adminNewPinInput').value.trim();
            if (newPin.length >= 4) storeData.adminPin = newPin;
            await saveCloudData();
            alert("Settings updated successfully!");
        }

        async function addNewCategory() {
            let name = document.getElementById('newCategoryName').value.trim();
            if (!storeData.categories) storeData.categories = [];
            if (name && !storeData.categories.includes(name)) {
                storeData.categories.push(name);
                document.getElementById('newCategoryName').value = "";
                await saveCloudData();
                alert("Category added successfully!");
            } else {
                alert("Please enter a valid or unique category name.");
            }
        }

        async function deleteCategory(cat) {
            storeData.categories = storeData.categories.filter(c => c !== cat);
            await saveCloudData();
        }

        function saveOrUpdateProduct() {
            let editId = document.getElementById('editProductId').value;
            let name = document.getElementById('newProdName').value.trim();
            let price = parseFloat(document.getElementById('newProdPrice').value);
            let category = document.getElementById('newProdCategory').value;
            let note = document.getElementById('newProdNote').value.trim();
            let fileInput = document.getElementById('newProdImageFile');

            if (!name || isNaN(price)) { alert("Enter valid product name and price."); return; }

            let btn = document.getElementById('addProdBtn');
            btn.innerText = "Compressing & Publishing...";
            btn.disabled = true;

            let defaultImg = "https://images.unsplash.com/photo-1584438784894-089d6a62b8fa?w=500";

            if (fileInput.files && fileInput.files[0]) {
                let reader = new FileReader();
                reader.onload = function(e) {
                    let img = new Image();
                    img.onload = function() {
                        let canvas = document.createElement('canvas');
                        let ctx = canvas.getContext('2d');
                        let MAX_WIDTH = 300;
                        let MAX_HEIGHT = 300;
                        let width = img.width;
                        let height = img.height;

                        if (width > height) {
                            if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                        } else {
                            if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                        }
                        canvas.width = width;
                        canvas.height = height;
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        let compressedDataUrl = canvas.toDataURL('image/jpeg', 0.5);
                        finalizeProductSave(editId, name, price, category, note, compressedDataUrl, btn);
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                let existingImage = defaultImg;
                if (editId) {
                    let existingProd = storeData.products.find(p => p.id == editId);
                    if (existingProd) existingImage = existingProd.image;
                }
                finalizeProductSave(editId, name, price, category, note, existingImage, btn);
            }
        }

        async function finalizeProductSave(editId, name, price, category, note, imageUrl, btn) {
            if (!storeData.products) storeData.products = [];

            if (editId) {
                let prod = storeData.products.find(p => p.id == editId);
                if (prod) {
                    prod.name = name;
                    prod.price = price;
                    prod.category = category;
                    prod.note = note;
                    prod.image = imageUrl;
                }
            } else {
                storeData.products.unshift({
                    id: Date.now(),
                    name: name,
                    price: price,
                    category: category,
                    note: note,
                    image: imageUrl
                });
            }

            resetProductForm();
            await saveCloudData();
            btn.innerText = "Save & Publish Instantly";
            btn.disabled = false;
            alert("Product published successfully!");
        }

        function editProduct(id) {
            let prod = storeData.products.find(p => p.id === id);
            if (!prod) return;

            document.getElementById('editProductId').value = prod.id;
            document.getElementById('newProdName').value = prod.name;
            document.getElementById('newProdPrice').value = prod.price;
            document.getElementById('newProdCategory').value = prod.category;
            document.getElementById('newProdNote').value = prod.note || "";

            document.getElementById('formTitle').innerText = "Edit Product: " + prod.name;
            document.getElementById('addProdBtn').innerText = "Update Product";
            document.getElementById('cancelEditBtn').classList.remove('hidden');
        }

        function resetProductForm() {
            document.getElementById('editProductId').value = "";
            document.getElementById('newProdName').value = "";
            document.getElementById('newProdPrice').value = "";
            document.getElementById('newProdNote').value = "";
            document.getElementById('newProdImageFile').value = "";
            document.getElementById('formTitle').innerText = "Add New PVC Product";
            document.getElementById('addProdBtn').innerText = "Save & Publish Instantly";
            document.getElementById('cancelEditBtn').classList.add('hidden');
        }

        async function deleteProduct(id) {
            if (confirm("Kya aap waqai is item ko delete karna chahte hain?")) {
                storeData.products = storeData.products.filter(p => p.id !== id);
                await saveCloudData();
            }
        }

        function renderAdminLists() {
            let catDropdown = document.getElementById('newProdCategory');
            let catList = document.getElementById('adminCategoryList');
            let dropHtml = "", listHtml = "";

            (storeData.categories || []).forEach(cat => {
                dropHtml += `<option value="${cat}">${cat}</option>`;
                listHtml += `<span class="bg-gray-800 text-xs text-white px-3 py-1.5 rounded-lg flex items-center space-x-2 border border-gray-700"><span>${cat}</span><button onclick="deleteCategory('${cat}')" class="text-red-400 font-bold">&times;</button></span>`;
            });
            if (catDropdown) catDropdown.innerHTML = dropHtml;
            if (catList) catList.innerHTML = listHtml;

            let prodList = document.getElementById('adminProductList');
            if (prodList) {
                let pHtml = "";
                (storeData.products || []).forEach(p => {
                    pHtml += `
                        <div class="flex items-center justify-between bg-cardBg p-3 rounded-xl border border-gray-700">
                            <div class="flex items-center space-x-3">
                                <img src="${p.image}" class="w-10 h-10 object-cover rounded-lg border border-gray-700">
                                <div>
                                    <h6 class="font-bold text-sm text-white">${p.name}</h6>
                                    <p class="text-xs text-primary font-semibold">Rs. ${p.price} | ${p.category}</p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                <button onclick="editProduct(${p.id})" class="bg-amber-600/20 text-amber-400 hover:bg-amber-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">Edit</button>
                                <button onclick="deleteProduct(${p.id})" class="bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">Delete</button>
                            </div>
                        </div>
                    `;
                });
                prodList.innerHTML = pHtml;
            }
        }

        window.onload = loadCloudData;
    </script>
</body>
</html>
